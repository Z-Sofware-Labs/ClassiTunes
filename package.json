{
  "name": "classitunes",
  "private": true,
  "version": "1.6.2",
  "author": "Z Software Labs",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "concurrently \"vite --port=3000\" \"wait-on http://localhost:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder",
    "clean": "rm -rf dist dist-electron server.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.classitunes.app",
    "productName": "ClassiTunes",
    "copyright": "Copyright © 2026 Z Software Labs",
    "executableName": "ClassiTunes",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "executableName": "ClassiTunes",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "rpm",
        "deb"
      ],
      "category": "Audio;AudioVideo;",
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "ClassiTunes",
      "uninstallDisplayName": "ClassiTunes",
      "createStartMenuShortcut": true,
      "createDesktopShortcut": "always",
      "menuCategory": "ClassiTunes"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tauri-apps/api": "^2.3.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@wasm-audio-decoders/ogg-vorbis": "^0.1.20",
    "buffer": "^6.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsmediatags": "^3.9.7",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "music-metadata": "^11.14.0",
    "music-metadata-browser": "^2.5.11",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "typedarray-to-buffer": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.3.0",
    "@types/express": "^4.17.21",
    "@types/jsmediatags": "^3.9.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  }
}
