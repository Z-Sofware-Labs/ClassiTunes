{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClassiTunes",
  "version": "1.1.1",
  "identifier": "com.classitunes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ClassiTunes",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Z Software Labs",
    "shortDescription": "ClassiTunes - Modern desktop audio player inspired by classic design",
    "longDescription": "ClassiTunes is a high performance audio player and library manager built with modern web technologies and Rust.",
    "copyright": "Copyright © 2026 Z Software Labs. All rights reserved.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2QjI1RDM0NkNBRTkyNEMKUldSTWtxNXNORjJ5RnF6S3BxdVp0RDR3REQ1eVBOUEpYZ3h5UWk1M1BqL3FReGVmRnp3WmJEUGgK",
      "endpoints": [
        "https://github.com/Z-Sofware-Labs/ClassiTunes/releases/latest/download/latest.json"
      ]
    }
  }
}